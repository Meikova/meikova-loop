# Files that run on the Linux server keep LF endings on every checkout:
# bash and systemd fail on CRLF.
*.sh text eol=lf
*.service text eol=lf
*.cfg text eol=lf
web/audio/silence.mp3 filter=lfs diff=lfs merge=lfs -text
web/img/app.icns filter=lfs diff=lfs merge=lfs -text
web/img/og.png filter=lfs diff=lfs merge=lfs -text
